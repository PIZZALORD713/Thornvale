{
  "name": "thornvale-kawaii-2",
  "version": "0.3.0",
  "description": "A premium kawaii cozy-horror village experience built with Three.js and Rapier.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "friendsies:index": "node scripts/build-friendsies-trait-index.mjs",
    "friendsies:atlas": "node scripts/serve-friendsies-trait-atlas.mjs",
    "friendsies:probe": "node scripts/probe-friendsies-trait.mjs",
    "animations:build": "node scripts/build-story-actions-v1.mjs",
    "animations:verify": "node scripts/build-story-actions-v1.mjs --verify",
    "pizza-lab:mcp": "node tools/pizza-lab/mcp/server.mjs",
    "pizza-lab:blender": "scripts/pizza-lab-blender.sh",
    "pizza-lab:stage": "/Applications/Blender-4.5-LTS.app/Contents/MacOS/Blender --background --factory-startup --python-exit-code 1 --python tools/pizza-lab/create_stage.py",
    "pizza-lab:test": "node --test tests/pizza-lab.test.js",
    "pizza-lab:verify": "/Applications/Blender-4.5-LTS.app/Contents/MacOS/Blender --background --factory-startup --python-exit-code 1 --python tools/pizza-lab/verify.py",
    "pizza-lab:promote": "node scripts/promote-pizza-lab-stage.mjs",
    "assets:audit": "node scripts/check-asset-budgets.mjs",
    "assets:release": "node scripts/check-asset-budgets.mjs --dist --release",
    "check": "npm run test && npm run build && npm run assets:audit -- --dist"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "vite": "^8.1.4"
  }
}
