{
  "name": "thornvale-kawaii-2",
  "version": "0.3.0",
  "description": "A premium kawaii cozy-horror village experience built with Three.js and Rapier.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "story-archive:dev": "vite --host 127.0.0.1 --open /story-archive/Preview/?id=friend%3A6602&mode=play",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "friendsies:index": "node scripts/build-friendsies-trait-index.mjs",
    "friendsies:atlas": "node scripts/serve-friendsies-trait-atlas.mjs",
    "friendsies:probe": "node scripts/probe-friendsies-trait.mjs",
    "animations:build": "node scripts/build-story-actions-v1.mjs",
    "animations:verify": "node scripts/build-story-actions-v1.mjs --verify",
    "object-cues:build": "node scripts/build-key-object-cues-v1.mjs",
    "object-cues:verify": "node scripts/build-key-object-cues-v1.mjs --verify",
    "pizza-lab:mcp": "node tools/pizza-lab/mcp/server.mjs",
    "pizza-lab:blender": "scripts/pizza-lab-blender.sh",
    "pizza-lab:stage": "/Applications/Blender-4.5-LTS.app/Contents/MacOS/Blender --background --factory-startup --python-exit-code 1 --python tools/pizza-lab/create_stage.py",
    "pizza-lab:test": "node --test tests/pizza-lab.test.js",
    "pizza-lab:verify": "/Applications/Blender-4.5-LTS.app/Contents/MacOS/Blender --background --factory-startup --python-exit-code 1 --python tools/pizza-lab/verify.py",
    "pizza-lab:promote": "node scripts/promote-pizza-lab-stage.mjs",
    "pizza-lab:world:bootstrap": "node scripts/bootstrap-world-stage-v1.mjs --acknowledge-overwrite",
    "pizza-lab:world:input": "node scripts/build-world-stage-input.mjs",
    "pizza-lab:world:build": "npm run pizza-lab:world:input && /Applications/Blender-4.5-LTS.app/Contents/MacOS/Blender --background --factory-startup --python-exit-code 1 --python tools/pizza-lab/create_world_stage.py",
    "pizza-lab:world:verify": "/Applications/Blender-4.5-LTS.app/Contents/MacOS/Blender --background output/pizza-lab/thornvale-world-stage-v1.blend --python-exit-code 1 --python tools/pizza-lab/verify_world_stage.py",
    "pizza-lab:wayfinder:seed": "/Applications/Blender-4.5-LTS.app/Contents/MacOS/Blender --background --factory-startup --python-exit-code 1 --python tools/pizza-lab/seed_wayfinder_authoring.py -- --acknowledge-overwrite",
    "pizza-lab:wayfinder:export": "/Applications/Blender-4.5-LTS.app/Contents/MacOS/Blender --background output/pizza-lab/thornvale-world-stage-v1.blend --python-exit-code 1 --python tools/pizza-lab/export_wayfinder_from_stage.py",
    "pizza-lab:wayfinder:promote": "node scripts/promote-pizza-lab-wayfinder.mjs",
    "assets:audit": "node scripts/check-asset-budgets.mjs",
    "assets:release": "node scripts/check-asset-budgets.mjs --dist --release",
    "check": "npm run test && npm run build && npm run assets:audit -- --dist"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "vite": "^8.1.4"
  }
}
