{
  "name": "thornvale-kawaii-2",
  "version": "0.3.0",
  "description": "A premium kawaii cozy-horror village experience built with Three.js and Rapier.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "friendsies:index": "node scripts/build-friendsies-trait-index.mjs",
    "friendsies:atlas": "node scripts/serve-friendsies-trait-atlas.mjs",
    "friendsies:probe": "node scripts/probe-friendsies-trait.mjs",
    "animations:build": "node scripts/build-story-actions-v1.mjs",
    "animations:verify": "node scripts/build-story-actions-v1.mjs --verify",
    "assets:audit": "node scripts/check-asset-budgets.mjs",
    "assets:release": "node scripts/check-asset-budgets.mjs --dist --release",
    "check": "npm run test && npm run build && npm run assets:audit -- --dist"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "vite": "^8.1.4"
  }
}
