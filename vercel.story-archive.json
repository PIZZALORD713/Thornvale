{
  "buildCommand": "npm run story-archive:build",
  "outputDirectory": "dist-story-archive",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "destination": "/story-archive/Preview/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
